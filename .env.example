# Database Configuration
DATABASE_URL=postgresql://postgres:your_password@user-db:5432/user-service
DB_PASSWORD=your_db_password
SONAR_DB_PASSWORD=your_sonar_password

# JWT Configuration
JWT_SECRET=your_jwt_secret
JWT_ACCESS_TOKEN_EXPIRES=3600

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# SonarQube Configuration
SONAR_TOKEN=your_sonar_token
SONAR_HOST_URL=http://localhost:9000

# Docker Registry Configuration
DOCKER_USERNAME=your_docker_username
DOCKER_PASSWORD=your_docker_password

# Kubernetes Configuration
# Base64 encoded values for k8s secrets
USER_DB_URL_BASE64=base64_encoded_user_db_url
SALLE_DB_URL_BASE64=base64_encoded_salle_db_url
RESERVATION_DB_URL_BASE64=base64_encoded_reservation_db_url
JWT_SECRET_BASE64=base64_encoded_jwt_secret
GOOGLE_CLIENT_ID_BASE64=base64_encoded_google_client_id
GOOGLE_CLIENT_SECRET_BASE64=base64_encoded_google_client_secret

# Database URLs
USER_DB_URL=postgresql://postgres:${DB_PASSWORD}@user-db:5432/user-service
SALLE_DB_URL=postgresql://postgres:${DB_PASSWORD}@salle-db:5432/salle-service
RESERVATION_DB_URL=postgresql://postgres:${DB_PASSWORD}@reservation-db:5432/reservation-service